<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Grants an exemption from Android 10+ background-activity-start restrictions
         so unlocks can be triggered with the screen off. User grants it in-app. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Package visibility (Android 11+): we check for both target apps. -->
    <queries>
        <package android:name="com.getpebble.android" />
        <package android:name="com.openpath.mobile" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Trampoline used when background activity starts are blocked
             (notification-tap fallback). Does the same trigger then finishes. -->
        <activity
            android:name=".UnlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <service
            android:name=".pebble.BridgeService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Pebble watch bridge: relays door unlocks between the Pebble watch app and the Avigilon Alta Open app" />
        </service>

        <!-- Receives AppMessages routed by the official Pebble Android app
             (com.getpebble.action.app.RECEIVE) for our watch-app UUID. -->
        <receiver
            android:name=".pebble.PebbleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.getpebble.action.app.RECEIVE" />
            </intent-filter>
            <meta-data
                android:name="com.getpebble.android.kit.UUID"
                android:value="2f9a7c41-5e3b-4d88-a6c2-7b1e0d5f4a33" />
        </receiver>
    </application>
</manifest>
